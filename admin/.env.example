# admin/.env - copied from this file on the build server and filled in (never committed: .gitignore).
# docker/repo/compose.yml reads it for both the panel and oauth2-proxy.

# --- the autobleem-admin GitHub App (admin/README.md, step 1) ---
AB_APP_ID=
# the App's private key file, mounted into the panel's container (compose maps admin/app-key.pem here)
AB_APP_KEY_FILE=/run/secrets/app-key.pem

# --- the login: oauth2-proxy over the same App's OAuth credentials ---
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# 32 random bytes, base64: python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
OAUTH2_PROXY_COOKIE_SECRET=

# --- who may act (every org member may look) ---
AB_RELEASE_TEAM=release-managers

# --- Telegram (optional: nothing is sent while either is empty) ---
AB_TELEGRAM_TOKEN=
AB_TELEGRAM_CHAT=
