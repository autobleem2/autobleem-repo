# The download repository (docker/repo/compose.yml). Two listeners over one read-only tree, /srv/repo.
{
    # port 80 belongs to the host's nginx: no HTTP-01 challenge and no http->https redirect from Caddy
    auto_https disable_redirects
    admin off
}

(repo) {
    root * /srv/repo
    file_server browse {
        hide .*
    }
    encode gzip
    # the machine-readable files and the landing page change on every publish; versioned folders never do
    @volatile path *.json /index.html /
    @versioned not path *.json /index.html /
    header @volatile Cache-Control "max-age=300"
    header @versioned Cache-Control "max-age=86400"
    header -Server
}

# The admin panel (admin/README.md) - HTTPS only. A client may never set the headers that say who is
# logged in: they are stripped here, and only oauth2-proxy sets them again. A script's request to the API
# with its own GitHub token as the bearer goes to the panel directly (it checks the token with GitHub); a
# browser goes through oauth2-proxy, which does the GitHub login. Nothing answers while the `admin` compose
# profile is not up (a 502 for /admin, the site untouched).
(admin) {
    @api_bearer {
        path /admin/api/*
        header Authorization "Bearer *"
    }
    handle @api_bearer {
        request_header -X-Forwarded-User
        request_header -X-Forwarded-Preferred-Username
        request_header -X-Forwarded-Email
        reverse_proxy admin:8000
    }
    handle /admin* {
        request_header -X-Forwarded-User
        request_header -X-Forwarded-Preferred-Username
        request_header -X-Forwarded-Email
        reverse_proxy oauth2-proxy:4180
    }
    handle /oauth2/* {
        reverse_proxy oauth2-proxy:4180
    }
}

# HTTPS, certificate from Let's Encrypt over TLS-ALPN-01 (needs only port 443 reachable at this name)
{$REPO_HOST} {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    import admin
    handle {
        import repo
    }
}

# plain HTTP - the direct address, and LAN tests
http://:9090 {
    import repo
}
