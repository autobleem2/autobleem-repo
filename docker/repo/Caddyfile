# The download repository (docker/repo/compose.yml). Two listeners over one read-only tree, /srv/repo.
{
    # port 80 belongs to the host's nginx: no HTTP-01 challenge and no http->https redirect from Caddy
    auto_https disable_redirects
    admin off
}

(repo) {
    root * /srv/repo
    file_server browse {
        hide .*
    }
    encode gzip
    # the machine-readable files, the splash and the download listing (the nightly list) change on every publish;
    # versioned folders never do
    @volatile path *.json /index.html / /repository/ /repository/index.html
    @versioned not path *.json /index.html / /repository/ /repository/index.html
    header @volatile Cache-Control "max-age=300"
    header @versioned Cache-Control "max-age=86400"
    header -Server
}

# The admin panel (admin/README.md) - HTTPS only. A client may never set the headers that say who is
# logged in: they are stripped here, and only oauth2-proxy sets them again. A script's request to the API
# with its own GitHub token as the bearer goes to the panel directly (it checks the token with GitHub); a
# browser goes through oauth2-proxy, which does the GitHub login. Nothing answers while the `admin` compose
# profile is not up (a 502 for /admin, the site untouched).
(admin) {
    @api_bearer {
        path /admin/api/*
        header Authorization "Bearer *"
    }
    handle @api_bearer {
        request_header -X-Forwarded-User
        request_header -X-Forwarded-Preferred-Username
        request_header -X-Forwarded-Email
        reverse_proxy admin:8000
    }
    handle /admin* {
        request_header -X-Forwarded-User
        request_header -X-Forwarded-Preferred-Username
        request_header -X-Forwarded-Email
        reverse_proxy oauth2-proxy:4180
    }
    handle /oauth2/* {
        reverse_proxy oauth2-proxy:4180
    }
}

# The tester portal's intake service (intake/README.md) - on both listeners, so the LAN rig on :9090 can test it.
# Caddy sets X-Forwarded-For itself (the client's address, replacing any value the client sent), which the
# service trusts only from this network. Nothing answers while the `portal` compose profile is not up (a 502 for
# /submit/*, the site untouched). The 26 MB cap is a belt over the service's own limits (25 MB for an issue).
(portal) {
    handle /submit/* {
        request_body {
            max_size 26MB
        }
        reverse_proxy intake:8000
    }
}

# The download counter's source (admin/app/downloads.py): a JSON access log of the HTTPS name, in a volume the
# admin service reads. It carries no IP address and no header - the filter deletes them before the line is written -
# and a request of a known bot or crawler is not logged at all. Rotated in plain text (the reader tells files by
# inode, and a compressed file would be a new one). Nothing here changes what a visitor gets.
(counted) {
    @bots header_regexp User-Agent (?i)(bot|spider|crawl|slurp|facebookexternalhit|preview)
    log_skip @bots
    log {
        output file /var/log/caddy/access.log {
            mode 0644
            roll_size 10MiB
            roll_keep 10
            roll_keep_for 720h
            roll_uncompressed
        }
        format filter {
            wrap json
            fields {
                request>remote_ip delete
                request>remote_port delete
                request>client_ip delete
                request>headers delete
                request>tls delete
                resp_headers delete
            }
        }
    }
}

# HTTPS, certificate from Let's Encrypt over TLS-ALPN-01 (needs only port 443 reachable at this name)
{$REPO_HOST} {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    import counted
    import /etc/caddy/private/*.caddy
    import admin
    import portal
    handle {
        import repo
    }
}

# plain HTTP - the direct address, and LAN tests
http://:9090 {
    import portal
    handle {
        import repo
    }
}
